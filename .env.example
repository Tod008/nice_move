# Resend (https://resend.com) — required for the Contact page form to actually send email.
# Copy this file to .env.local and fill in real values; .env.local is gitignored.

RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional — must be a sender on a domain verified in Resend. Defaults to Resend's
# shared test sender, which only delivers to the Resend account owner's own email.
CONTACT_FROM_EMAIL=

# Google Maps JavaScript API — powers the interactive office map in the footer.
# Restrict this key by HTTP referrer (production domain + localhost) in Google Cloud
# Console. It is public in client source either way; the restriction is what protects
# the billing account. Enable only "Maps JavaScript API" + billing on the project.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional — a Map ID from Google Cloud > Map Management. Required for vector rendering
# (smooth camera moves/tilt); falls back to Google's DEMO_MAP_ID, which is fine for local
# dev only. Also where Cloud-based styling would live if the map should match the brand.
NEXT_PUBLIC_GOOGLE_MAP_ID=
